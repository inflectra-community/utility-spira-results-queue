# =============================================================================
# Spira Results Queue - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.

# -----------------------------------------------------------------------------
# Gateway (API Server that mimics Spira)
# -----------------------------------------------------------------------------
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0

# Gateway concurrency controls — prevent the gateway from replicating
# the same overload problem that Spira experiences under high concurrency
GATEWAY_MAX_CONCURRENT=50
GATEWAY_MAX_QUEUE=200
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_MAX=100
GATEWAY_MAX_REQUEST_BYTES=10485760

# -----------------------------------------------------------------------------
# RabbitMQ Connection
# -----------------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=spira-test-results
RABBITMQ_EXCHANGE=spira-results
RABBITMQ_ROUTING_KEY=test-run.record

# -----------------------------------------------------------------------------
# Real Spira Instance (where results ultimately get posted)
# -----------------------------------------------------------------------------
SPIRA_BASE_URL=https://your-instance.spiraservice.net
SPIRA_API_KEY=your-api-key-here
SPIRA_USERNAME=your-username

# -----------------------------------------------------------------------------
# Worker Configuration
# -----------------------------------------------------------------------------
# Number of results to post concurrently to Spira (3-5 recommended)
WORKER_CONCURRENCY=3
# Number of messages to prefetch from RabbitMQ at once
WORKER_PREFETCH=10
# Retry attempts for failed Spira API calls
WORKER_MAX_RETRIES=3
# Delay between retries in milliseconds (exponential backoff base)
WORKER_RETRY_DELAY_MS=1000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
